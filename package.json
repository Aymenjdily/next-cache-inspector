{
  "name": "next-cache-inspector",
  "version": "0.4.0",
  "description": "Inspect and analyze Next.js App Router caching strategy",
  "main": "dist/cli.mjs",
  "bin": {
    "next-cache-inspector": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "public",
