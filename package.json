    "tsconfig.json",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "components.json",
    "demo-graph.json",
    "next-env.d.ts"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "tsup",
    "prepublishOnly": "npm run build:cli",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@xyflow/react": "^12.9.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "dagre": "^0.8.5",
    "geist": "^1.7.0",
    "lucide-react": "^0.542.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4.1.13",
    "ts-morph": "^27.0.2",
    "typescript": "5.9.3",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
